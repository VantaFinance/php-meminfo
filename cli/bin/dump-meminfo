#!/usr/bin/env php
<?php
/**
 * Dump the memory of a running PHP process.
 *
 * PHP does not let an extension add a `php <subcommand>`, so this is a thin
 * wrapper around meminfo_dump_process(): it parses argv and prints the path of
 * the dump the target wrote.
 *
 * Installed as vendor/bin/dump-meminfo by the vanta/dump-meminfo Composer
 * package, whose bin proxy includes this file instead of executing it: keep
 * everything at the top level working when included.
 *
 * Written for PHP 7.0 syntax — it has to run on the oldest version the
 * extension supports. It also sticks to functions that are always built in
 * (no ctype, posix or json): it must work under `php -n`, where shared
 * extensions are not loaded.
 *
 * @author    Benoit Jacquemont <benoit.jacquemont@gmail.com>
 * @author    Vlad Shashkov <v.shashkov@pos-credit.ru>
 * @copyright 2010-2021 Benoit Jacquemont
 * @copyright 2026 The Vanta
 * @license   http://opensource.org/licenses/MIT MIT
 */

defined('EXIT_OK') || define('EXIT_OK', 0);
defined('EXIT_FAILED') || define('EXIT_FAILED', 1);
defined('EXIT_USAGE') || define('EXIT_USAGE', 2);

/**
 * @param resource $stream
 * @param string   $message
 */
function dump_meminfo_write($stream, $message)
{
    fwrite($stream, $message . "\n");
}

/**
 * @return string
 */
function dump_meminfo_usage()
{
    return implode("\n", array(
        'Usage: dump-meminfo <pid> [options]',
        '',
        'Dumps the memory of a running PHP process to a JSON file and prints its path',
        '(or its s3:// location once the target has uploaded it, see --wait-upload).',
        'The target must have the meminfo extension loaded and be inside a request.',
        '',
        'Options:',
        '  --dir=DIR        Directory to write the dump to; the target is told to',
        '                   write it there (default: the target\'s own meminfo.dump_dir,',
        '                   looked for in the meminfo.dump_dir of this process)',
        '  --signal=SIG     Signal to send, by name or number (default: the',
        '                   meminfo.dump_signal of this process, normally SIGURG)',
        '  --timeout=SEC    Seconds to wait for the dump to start (default: 30).',
        '                   Once it has started, the wait continues while it grows.',
        '  --force          Send the signal even when the target does not appear to',
        '                   handle it. May terminate a target that is not listening.',
        '  --wait-upload    Wait until the target has uploaded the dump (its',
        '                   meminfo.dump_upload, e.g. S3) and print where it went,',
        '                   s3://bucket/key, instead of the local path',
        '  --count=N        Take N dumps in a row, one path per line in order (default: 1).',
        '                   Comparing three or more shows what keeps growing.',
        '  --interval=TIME  Wait between two dumps of a series: seconds, or a number',
        '                   with s or m (default: 60s)',
        '  -h, --help       Show this help',
        '',
        'Example:',
        '  dump-meminfo 12345',
        '  dump-meminfo 12345 --dir=/var/tmp --timeout=60',
        '  dump-meminfo 12345 --count=3 --interval=5m',
        '  dump-meminfo 12345 --wait-upload',
        '',
        'Open the dump in the browser UI (nothing is uploaded):',
        '  https://vantafinance.github.io/php-meminfo/',
    ));
}

/**
 * @param array $argv
 *
 * @return array|int parsed arguments, or an exit code when argv is unusable
 */
function dump_meminfo_parse($argv)
{
    $pid = null;
    $options = array();
    $dumps = 1;
    $interval = 60;

    for ($i = 1, $count = count($argv); $i < $count; $i++) {
        $argument = $argv[$i];

        if ($argument === '-h' || $argument === '--help') {
            dump_meminfo_write(STDOUT, dump_meminfo_usage());

            return EXIT_OK;
        }

        if ($argument === '--force') {
            $options['force'] = true;
            continue;
        }

        if ($argument === '--wait-upload') {
            $options['wait_upload'] = true;
            continue;
        }

        if (strpos($argument, '--dir=') === 0) {
            $options['dir'] = substr($argument, strlen('--dir='));
            continue;
        }

        if (strpos($argument, '--signal=') === 0) {
            $options['signal'] = substr($argument, strlen('--signal='));
            continue;
        }

        if (strpos($argument, '--count=') === 0) {
            $value = substr($argument, strlen('--count='));

            if (!preg_match('/^[0-9]+$/D', $value) || (int) $value < 1) {
                dump_meminfo_write(STDERR, 'dump-meminfo: --count must be a positive integer');

                return EXIT_USAGE;
            }

            $dumps = (int) $value;
            continue;
        }

        if (strpos($argument, '--interval=') === 0) {
            $value = substr($argument, strlen('--interval='));

            if (!preg_match('/^([0-9]+)(s|m)?$/D', $value, $match)) {
                dump_meminfo_write(STDERR, 'dump-meminfo: --interval must be seconds, like 30, 30s or 5m');

                return EXIT_USAGE;
            }

            $interval = (int) $match[1] * (isset($match[2]) && $match[2] === 'm' ? 60 : 1);
            continue;
        }

        if (strpos($argument, '--timeout=') === 0) {
            $timeout = substr($argument, strlen('--timeout='));

            if (!preg_match('/^[0-9]+$/D', $timeout) || (int) $timeout < 1) {
                dump_meminfo_write(STDERR, 'dump-meminfo: --timeout must be a positive integer');

                return EXIT_USAGE;
            }

            $options['timeout'] = (int) $timeout;
            continue;
        }

        if ($argument === '' || $argument[0] === '-') {
            dump_meminfo_write(STDERR, 'dump-meminfo: unknown option ' . $argument);
            dump_meminfo_write(STDERR, dump_meminfo_usage());

            return EXIT_USAGE;
        }

        if ($pid !== null) {
            dump_meminfo_write(STDERR, 'dump-meminfo: only one pid may be given');

            return EXIT_USAGE;
        }

        if (!preg_match('/^[0-9]+$/D', $argument) || (int) $argument < 1) {
            dump_meminfo_write(STDERR, 'dump-meminfo: pid must be a positive integer');

            return EXIT_USAGE;
        }

        $pid = (int) $argument;
    }

    if ($pid === null) {
        dump_meminfo_write(STDERR, dump_meminfo_usage());

        return EXIT_USAGE;
    }

    return array('pid' => $pid, 'options' => $options, 'count' => $dumps, 'interval' => $interval);
}

/**
 * @param array $argv
 *
 * @return int exit code
 */
function dump_meminfo_main($argv)
{
    $parsed = dump_meminfo_parse($argv);

    if (!is_array($parsed)) {
        return $parsed;
    }

    if (!extension_loaded('meminfo')) {
        dump_meminfo_write(STDERR, implode("\n", array(
            'dump-meminfo: the meminfo extension is not loaded in this PHP.',
            '',
            'Install it with',
            '    pie install vanta/meminfo',
            'or enable an existing build by adding',
            '    extension=meminfo.so',
            'to your php.ini, or run this command with',
            '    php -d extension=meminfo.so ' . $argv[0] . ' ...',
        )));

        return EXIT_FAILED;
    }

    if (!function_exists('meminfo_dump_process')) {
        dump_meminfo_write(STDERR,
            'dump-meminfo: this meminfo build cannot signal other processes (Windows is not supported).');

        return EXIT_FAILED;
    }

    for ($index = 1; $index <= $parsed['count']; $index++) {
        if ($index > 1) {
            sleep($parsed['interval']);
        }

        $started = microtime(true);

        // The exception message explains exactly which step failed and already
        // names the function it came from. It belongs on stderr so that stdout
        // stays parseable as nothing but the paths.
        try {
            $path = meminfo_dump_process($parsed['pid'], $parsed['options']);
        } catch (InvalidArgumentException $exception) {
            // The call itself was wrong, which for a command is a usage error —
            // the same exit code the argument parsing above returns.
            dump_meminfo_write(STDERR, $exception->getMessage());

            return EXIT_USAGE;
        } catch (Exception $exception) {
            // A target that exits mid-series ends up here: the dumps already
            // taken are printed, and the series stops.
            if ($parsed['count'] > 1) {
                dump_meminfo_write(STDERR, sprintf('dump-meminfo: dump %d of %d failed', $index, $parsed['count']));
            }
            dump_meminfo_write(STDERR, $exception->getMessage());

            return EXIT_FAILED;
        }

        dump_meminfo_write(STDOUT, $path);

        if ($parsed['count'] > 1) {
            dump_meminfo_write(STDERR, sprintf('dump-meminfo: dump %d of %d written in %.1f s: %s',
                $index, $parsed['count'], microtime(true) - $started, $path));
        }
    }

    return EXIT_OK;
}

ini_set('display_errors', 'stderr');

exit(dump_meminfo_main($argv));
